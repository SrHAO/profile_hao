---
import Layout from "../layouts/layout.astro";
import ImageCarousel from "../components/ImageCarousel.astro";
import "../styles/proyect.css";

const projectImages = [
  {
    type: "video",
    src: "/videos/Architectural.mp4",
    poster: "/images/Construct.webp",
    alt: "Proyecto de página para una constructora",
    title: "Proyecto de página para una constructora",
    description: "Una página moderna creada con Astro",
    titleEn: "Website project for a construction company",
    titleEs: "Proyecto de página para una constructora",
    descriptionEn: "A modern website built with Astro",
    descriptionEs: "Una página moderna creada con Astro",
    href: "https://construct-template-ozd1.vercel.app/es",
  },
  {
    type: "video",
    src: "/videos/Person_editi.mp4",
    poster: "/images/fases-produccion.webp",
    alt: "Producción audio-video",
    title: "Producción audio-video",
    description: "Proyecto de producción de audio y video",
    titleEn: "Audio-video production",
    titleEs: "Producción audio-video",
    descriptionEn: "Audio and video production project",
    descriptionEs: "Proyecto de producción de audio y video",
    href: "https://editor-sound-video.vercel.app/",
  },
  {
    src: "https://picsum.photos/1200/675?random=3",
    alt: "Project 3",
    title: "Project Three",
    description: "Portfolio website with animations",
    titleEn: "Project Three",
    titleEs: "Proyecto Tres",
    descriptionEn: "Portfolio website with animations",
    descriptionEs: "Sitio portafolio con animaciones",
  },
  {
    src: "https://picsum.photos/1200/675?random=4",
    alt: "Project 4",
    title: "Project Four",
    description: "Mobile-first responsive design",
    titleEn: "Project Four",
    titleEs: "Proyecto Cuatro",
    descriptionEn: "Mobile-first responsive design",
    descriptionEs: "Diseño responsivo mobile-first",
  },
  {
    src: "https://picsum.photos/1200/675?random=5",
    alt: "Project 5",
    title: "Project Five",
    description: "Dashboard with data visualization",
    titleEn: "Project Five",
    titleEs: "Proyecto Cinco",
    descriptionEn: "Dashboard with data visualization",
    descriptionEs: "Panel de control con visualización de datos",
  },
];
---

<Layout title="Projects - Web Developer Profile">
  <div class="container mx-auto px-4 md:px-8 lg:px-16 py-20 max-w-7xl">
    <h1
      class="proyects-title"
      data-translate
      data-en="Projects"
      data-es="Proyectos"
    >
      Proyects
    </h1>

    <div class="carousel-wrapper">
      <ImageCarousel images={projectImages} />
    </div>
    <div
      class="mt-8 md:mt-12 p-6 md:p-8 bg-white/80 dark:bg-gray-800/80 backdrop-blur-md rounded-2xl shadow-xl border border-gray-200/50 dark:border-gray-700/50 mx-auto max-w-4xl text-center text-base md:text-lg leading-relaxed text-gray-700 dark:text-gray-300 transition-all duration-500 hover:shadow-2xl"
    >
      <p
        data-translate
        data-en="There are currently no projects available. However, this space will be updated soon, and the images will be replaced with working projects. In the meantime, enjoy the images shown."
        data-es="Actualmente no hay proyectos disponibles. Sin embargo, este espacio se actualizará pronto y las imágenes se reemplazarán con proyectos funcionales. Mientras tanto, disfruta de las imágenes mostradas."
      >
        There are currently no projects available. However, this space will be
        updated soon, and the images will be replaced with working projects. In
        the meantime, enjoy the images shown.
      </p>
    </div>
  </div>
</Layout>

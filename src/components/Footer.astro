---
import "../styles/footer.css";
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-content">
      <!-- Logo left -->
      <div class="footer-left">
        <a href="/" aria-label="Home">
          <img
            src="/images/AlanLogoEn.svg"
            alt="Alan Navarrete - Home"
            class="footer-logo footer-logo-en hover:scale-110 transition-all duration-300"
          />
          <img
            src="/images/AlanLogoEs.svg"
            alt="Alan Navarrete - Inicio"
            class="footer-logo footer-logo-es hover:scale-110 transition-all duration-300"
          />
        </a>
      </div>

      <!-- Social icons center -->
      <div class="footer-center">
        <div class="social-links-group">
          <a
            href="https://www.linkedin.com/in/alan-navarrete/"
            target="_blank"
            rel="noopener"
            aria-label="LinkedIn"
            class="social-link linkedin"
          >
            <img
              src="/images/linkedin.svg"
              alt="LinkedIn"
              width="40"
              height="40"
              class="w-10 h-10"
            />
          </a>
          <a
            href="https://github.com/SrHAO"
            target="_blank"
            rel="noopener"
            aria-label="GitHub"
            class="social-link github"
          >
            <img
              src="/images/github.svg"
              alt="GitHub"
              width="40"
              height="40"
              class="w-10 h-10"
            />
          </a>
          <a
            id="email-link"
            aria-label="Email"
            class="social-link email"
          >
            <img
              src="/images/Gmail2.svg"
              alt="Gmail"
              width="40"
              height="40"
              class="w-10 h-10"
            />
          </a>
          <a
            href="https://wa.me/5543547891?text=Hola%20quiero%20contactarte"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
            class="social-link whatsapp"
          >
            <img
              src="/images/whatsapp.svg"
              alt="WhatsApp"
              width="40"
              height="40"
              class="w-10 h-10"
            />
          </a>
        </div>
      </div>

      <!-- Contact box right -->
      <div class="footer-right">
        <form class="contact-form" id="footer-contact-form" novalidate>
          <h4
            class="contact-form-title"
            data-translate
            data-en="Contact"
            data-es="Contacto"
          >
            Contact
          </h4>
          <div class="form-group">
            <input
              type="email"
              name="email"
              placeholder="Email"
              required
              data-translate
              data-placeholder-en="Email"
              data-placeholder-es="Correo electrónico"
            />
          </div>
          <div class="form-group">
            <input
              type="tel"
              name="phone"
              placeholder="Phone"
              data-translate
              data-placeholder-en="Phone"
              data-placeholder-es="Teléfono"
            />
          </div>
          <div class="form-group">
            <textarea
              name="message"
              rows="3"
              placeholder="Message"
              required
              data-translate
              data-placeholder-en="Message"
              data-placeholder-es="Mensaje"
            ></textarea>
          </div>
          <button
            type="submit"
            class="form-submit-btn"
            data-translate
            data-en="Send"
            data-es="Enviar"
          >
            Send
          </button>
        </form>
      </div>

      <!-- Copyright -->
      <div class="copyright-section">
        <p
          class="copyright"
          data-translate
          data-en="© 2024 Alan Navarrete Profile. All rights reserved."
          data-es="© 2024 Alan Navarrete Profile. Todos los derechos reservados."
        >
          © 2024 Alan Navarrete Profile. All rights reserved.
        </p>

        <div class="legal-links">
          <button
            type="button"
            class="legal-link"
            data-translate
            data-en="Terms & Conditions"
            data-es="Términos y condiciones"
            data-doc-en="/CV/terms_and_conditions_international_en.txt"
            data-doc-es="/CV/t_rminos_y_condiciones_internacionales.txt"
            data-title-en="Terms and Conditions of Use and Service Provision (International Coverage)"
            data-title-es="Términos y Condiciones de Uso y Prestación de Servicios (Cobertura Internacional)"
          >
            Terms & Conditions
          </button>
          <span class="legal-sep" aria-hidden="true">·</span>
          <button
            type="button"
            class="legal-link"
            data-translate
            data-en="Privacy Notice"
            data-es="Aviso de privacidad"
            data-doc-en="/CV/privacy_notice_international_en.txt"
            data-doc-es="/CV/aviso_de_privacidad_internacional.txt"
            data-title-en="Comprehensive Privacy Notice (International Standard)"
            data-title-es="Aviso de Privacidad Integral (Estándar Internacional)"
          >
            Privacy Notice
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Legal document modal -->
  <div class="legal-modal" id="legal-modal" hidden>
    <div class="legal-modal-overlay" data-close-legal></div>
    <div
      class="legal-modal-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="legal-modal-title"
    >
      <div class="legal-modal-header">
        <h3 class="legal-modal-title" id="legal-modal-title"></h3>
        <button
          type="button"
          class="legal-modal-close"
          aria-label="Close"
          data-close-legal
        >
          &times;
        </button>
      </div>
      <div class="legal-modal-body">
        <pre class="legal-modal-content"></pre>
      </div>
    </div>
  </div>
</footer>

<script>
  const user = "al.yoab.nav.sa";
  const domain = "gmail";
  const tld = 'com'

  const emailLink = document.getElementById("email-link");

  if (emailLink) {
    emailLink.href = `mailto:${user}@${domain}.${tld}`;
  }
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("footer-contact-form");
    if (form) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const email = String(formData.get("email") || "");
        const phone = String(formData.get("phone") || "");
        const message = String(formData.get("message") || "");
        const body = `Email: ${email}\nPhone: ${phone}\n\n${message}`;
        const mailto = `mailto:al.yoab.nav.sa@gmail.com?subject=Contacto desde Portfolio&body=${encodeURIComponent(body)}`;
        const whatsapp = `https://wa.me/5543547891?text=${encodeURIComponent(body)}`;

        window.location.href = mailto;
        window.open(whatsapp, "_blank", "noopener");
      });
    }
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("legal-modal");
    if (!modal) return;

    const titleEl = modal.querySelector(
      ".legal-modal-title",
    ) as HTMLElement | null;
    const contentEl = modal.querySelector(
      ".legal-modal-content",
    ) as HTMLElement | null;
    const closeBtn = modal.querySelector(
      ".legal-modal-close",
    ) as HTMLElement | null;
    const triggers = Array.from(
      document.querySelectorAll<HTMLElement>("[data-doc-en]"),
    );

    let lastFocused: HTMLElement | null = null;
    let requestId = 0;

    function getLang(): "en" | "es" {
      const lang =
        localStorage.getItem("lang") ||
        document.documentElement.lang ||
        "en";
      return lang.startsWith("es") ? "es" : "en";
    }

    async function openModal(trigger: HTMLElement) {
      const lang = getLang();
      const doc =
        trigger.getAttribute(`data-doc-${lang}`) ||
        trigger.getAttribute("data-doc-en") ||
        "";
      const title =
        trigger.getAttribute(`data-title-${lang}`) ||
        trigger.getAttribute("data-title-en") ||
        "";

      if (!doc) return;

      lastFocused = document.activeElement as HTMLElement | null;
      if (titleEl) titleEl.textContent = title;
      if (contentEl) contentEl.textContent = "Loading...";

      modal.hidden = false;
      document.body.style.overflow = "hidden";

      const id = ++requestId;
      try {
        const res = await fetch(doc);
        if (!res.ok) throw new Error(String(res.status));
        const text = await res.text();
        if (id === requestId && contentEl) contentEl.textContent = text;
      } catch {
        if (id === requestId && contentEl) {
          contentEl.textContent =
            "No se pudo cargar el documento. / Could not load the document.";
        }
      }

      closeBtn?.focus();
    }

    function closeModal() {
      modal!.hidden = true;
      document.body.style.overflow = "";
      requestId++;
      lastFocused?.focus();
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => openModal(trigger));
    });

    modal.querySelectorAll("[data-close-legal]").forEach((el) => {
      el.addEventListener("click", closeModal);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !modal.hidden) closeModal();
    });
  });
</script>
---
import "../styles/footer.css";
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-content">
      <!-- Logo -->
      <div class="footer-left">
        <a href="/" aria-label="Home">
          <img
            src="/images/AlanLogoD.svg"
            alt="Logo Alan - Home"
            class="footer-logo hover:scale-110 transition-all duration-300"
          />
        </a>
      </div>

      <!-- Contact center -->
      <div class="footer-center">
        <h4
          class="contact-title"
          data-translate
          data-en="Contact"
          data-es="Contacto"
        >
          Contact
        </h4>
        <div class="footer-icons-row">
          <div class="created-section">
            <ul class="contact-info">
              <li
                class="created-by"
                data-translate
                data-en="Created by: Alan Navarrete S"
                data-es="Creado por: Alan Navarrete S"
              >
                Created by: Alan Navarrete S
              </li>

              <li
                class="location"
                data-translate
                data-en="Location: Mexico City"
                data-es="Ubicación: Ciudad de México"
              >
                Location: Mexico City
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Social icons right -->
      <div class="footer-right">
        <div class="social-links-group">
          
          <a
            href="https://www.linkedin.com/in/alan-navarrete/"
            target="_blank"
            rel="noopener"
            aria-label="LinkedIn"
            class="social-link linkedin"
          >
            <img
              src="/images/linkedin.svg"
              alt="LinkedIn"
              width="40"
              height="40"
              class="w-10 h-10"
            />
          </a>
          <a
            href="https://github.com/SrHAO"
            target="_blank"
            rel="noopener"
            aria-label="GitHub"
            class="social-link github"
          >
            <img
              src="/images/github.svg"
              alt="GitHub"
              width="40"
              height="40"
              class="w-10 h-10"
            />
          </a>
          <a
            id="email-link"
            aria-label="Email"
            class="social-link email"
          >
            <img
              src="/images/Gmail2.svg"
              alt="Gmail"
              width="40"
              height="40"
              class="w-10 h-10"
            />
          </a>
          <a
            href="https://wa.me/5543547891?text=Hola%20quiero%20contactarte"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
            class="social-link whatsapp"
          >
            <img
              src="/images/whatsapp.svg"
              alt="WhatsApp"
              width="40"
              height="40"
              class="w-10 h-10"
            />
          </a>
        </div>
      </div>

      <!-- Copyright -->
      <div class="copyright-section">
        <p
          class="copyright"
          data-translate
          data-en="© 2024 Alan Navarrete Profile. All rights reserved."
          data-es="© 2024 Alan Navarrete Profile. Todos los derechos reservados."
        >
          © 2024 Alan Navarrete Profile. All rights reserved.
        </p>
      </div>
    </div>
  </div>
</footer>

<script>
  const user = "al.yoab.nav.sa";
  const domain = "gmail";
  const tld = 'com'

  const emailLink = document.getElementById("email-link");

  if (emailLink) {
    emailLink.href = `mailto:${user}@${domain}.${tld}`;
  }
</script>
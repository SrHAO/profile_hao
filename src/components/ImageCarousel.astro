---
import "../styles/carousel.css";

interface Props {
  images: {
    src: string;
    alt: string;
    title?: string;
    description?: string;
    titleEn?: string;
    titleEs?: string;
    descriptionEn?: string;
    descriptionEs?: string;
    href?: string;
  }[];
}

const { images } = Astro.props;

  const COMING_SOON = {
    src: 'https://images.unsplash.com/photo-1573164713988-8665fc963095?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&h=675&q=80',
    alt: 'Coming Soon',
    title: 'Coming Soon',
    description: 'More amazing projects coming soon!',
    titleEn: 'Coming Soon',
    titleEs: 'Próximamente',
    descriptionEn: 'More amazing projects coming soon!',
    descriptionEs: '¡Más proyectos increíbles próximamente!'
  };

  const allImages = [...images, COMING_SOON];

  const carouselImages = [
    { ...allImages[allImages.length - 1], isClone: true },
    ...allImages.map((image) => ({ ...image, isClone: false })),
    { ...allImages[0], isClone: true },
  ];
---

<div class="carousel">
  <button class="carousel-btn prev">❮</button>

  <div class="carousel-window">
    <div class="carousel-track" style="transform: translateX(-100%)">
      {
        carouselImages.map((image) => (
          <div
            class="carousel-slide"
            aria-hidden={image.isClone ? "true" : undefined}
          >
            {image.href ? (
              <a
                href={image.href}
                target="_blank"
                rel="noopener noreferrer"
                tabindex={image.isClone ? -1 : undefined}
              >
                <img src={image.src} alt={image.alt} />
              </a>
            ) : (
              <img src={image.src} alt={image.alt} />
            )}
            <div class="carousel-caption">
{image.title && (
                <h2
                  data-translate
                  data-en={image.titleEn ?? image.title}
                  data-es={image.titleEs ?? image.title}
                >
                  {image.title}
                </h2>
              )}
{image.description && (
                <p
                  data-translate
                  data-en={image.descriptionEn ?? image.description}
                  data-es={image.descriptionEs ?? image.description}
                >
                  {image.description}
                </p>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <button class="carousel-btn next">❯</button>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const track = document.querySelector(".carousel-track") as HTMLElement | null;
    const nextBtn = document.querySelector(
      ".carousel-btn.next",
    ) as HTMLButtonElement | null;
    const prevBtn = document.querySelector(
      ".carousel-btn.prev",
    ) as HTMLButtonElement | null;

    if (!track || !nextBtn || !prevBtn) return;

    const slides = Array.from(track.children) as HTMLElement[];
    if (slides.length < 3) return;

    let index = 1;
    let isAnimating = false;
    let animTimer: number | undefined;

    function applyTransform(animate: boolean) {
      track!.style.transition = animate ? "" : "none";
      track!.style.transform = `translateX(-${index * 100}%)`;
      if (!animate) {
        void track!.offsetWidth;
      }
    }

    function normalize() {
      window.clearTimeout(animTimer);
      isAnimating = false;
      if (index === 0) {
        index = slides.length - 2;
        applyTransform(false);
      } else if (index === slides.length - 1) {
        index = 1;
        applyTransform(false);
      }
    }

    function beginAnimation() {
      isAnimating = true;
      window.clearTimeout(animTimer);
      animTimer = window.setTimeout(() => {
        if (isAnimating) normalize();
      }, 700);
    }

    applyTransform(false);

    nextBtn.addEventListener("click", () => {
      if (isAnimating || index >= slides.length - 1) return;
      index++;
      beginAnimation();
      applyTransform(true);
    });

    prevBtn.addEventListener("click", () => {
      if (isAnimating || index <= 0) return;
      index--;
      beginAnimation();
      applyTransform(true);
    });

    track.addEventListener("transitionend", (event) => {
      const transition = event as TransitionEvent;
      if (transition.target !== track || transition.propertyName !== "transform") {
        return;
      }
      normalize();
    });
  });
</script>

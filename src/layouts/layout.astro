---
import Sidebar from "../components/Sidebar.astro";
import TopControls from "../components/TopControls.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import CVButton from "../components/CVButton.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const {
  title,
  lang = "en",
  description = "Web Developer Portfolio - Showcasing projects and skills",
} = Astro.props;
---

<!doctype html>
<html lang={Astro.props.lang || "en"} id="html-lang">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/images/logosv-red.svg"
    />

    <meta name="description" content={description} />

    <title>{title}</title>

    <script is:inline>
      (function () {
        // Initialize language first (default to 'en')
        let storedLang = localStorage.getItem("lang");
        if (!storedLang) {
          storedLang = "en";
          localStorage.setItem("lang", storedLang);
        }
        document.documentElement.lang = storedLang;

        /* Initializes dark mode from localStorage on page load */
        const storedTheme = localStorage.getItem("theme");
        if (storedTheme === "dark" || !storedTheme) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>

  <body class="min-h-screen flex flex-col transition-colors duration-300">
    <div class="site-bg" aria-hidden="true">
      <video
        class="site-bg-video"
        src="/videos/Fort.mp4"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
      ></video>
      <div class="site-bg-overlay"></div>
    </div>
    <Sidebar />
    <TopControls />

    <main class="flex-1">
      <slot />
    </main>

   
    <Footer />

    <BackToTop />
  </body>
</html>

<script>
  const HIDE_CLASS = "-translate-y-full";
  const SHOW_CLASS = "translate-y-0";
  const THRESHOLD = 6;

  function initSmartHeader(): void {
    const headers = Array.from(
      document.querySelectorAll<HTMLElement>("[data-smart-header]"),
    );
    if (headers.length === 0) return;

    const sidebar = document.getElementById(
      "sidebar-toggle",
    ) as HTMLInputElement | null;
    let lastScrollTop: number = window.scrollY;
    let ticking = false;

    const setHidden = (hidden: boolean): void => {
      for (const el of headers) {
        el.classList.toggle(HIDE_CLASS, hidden);
        el.classList.toggle(SHOW_CLASS, !hidden);
      }
    };

    const update = (): void => {
      const scrollTop: number = window.scrollY;
      const sidebarOpen: boolean = sidebar?.checked ?? false;

      if (sidebarOpen || scrollTop <= THRESHOLD) {
        setHidden(false);
      } else if (scrollTop > lastScrollTop + THRESHOLD) {
        setHidden(true);
      } else if (scrollTop < lastScrollTop - THRESHOLD) {
        setHidden(false);
      }

      lastScrollTop = scrollTop;
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(update);
        }
      },
      { passive: true },
    );

    document
      .getElementById("backToTop")
      ?.addEventListener("click", () => setHidden(false));
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSmartHeader);
  } else {
    initSmartHeader();
  }
</script>
